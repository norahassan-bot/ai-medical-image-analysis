# =============================================================================
# Backend Environment Configuration Example
# Copy this file to .env for local overrides (never commit .env)
# =============================================================================

# Application Environment (development | production | test)
ENVIRONMENT=production
PROJECT_NAME="AI Medical Image Analysis & Clinical Decision Support"
API_V1_PREFIX=/api/v1

# Network & Server Binding
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Storage Persistence Paths
DATABASE_PATH=data/medical_ai.db
STORAGE_DIR=data/visualizations
PDF_REPORTS_DIR=../reports/pdf

# Trained Model Checkpoint Path & Version
MODEL_CHECKPOINT_PATH=models/best_model.pth
MODEL_VERSION=1.0.0

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760
