# Version Control
.git/
.gitignore
.github/

# Python artifacts
backend/.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/

# Node.js artifacts
frontend/node_modules/
frontend/.next/
frontend/coverage/

# Datasets (Prevent embedding entire training datasets into Docker context)
data/chest_xray/

# Local database and visualization artifacts
backend/data/*.db
backend/data/visualizations/*
reports/pdf/*

# Local environment and secret files
.env
.env.*
backend/.env
frontend/.env.local
!.env.example
!backend/.env.example
!frontend/.env.example
!frontend/.env.local.example

# Documentation & IDE
.vscode/
.idea/
*.log
